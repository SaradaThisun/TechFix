<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Blue header with technician profile -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_accent_gradient"
        android:paddingHorizontal="20dp" android:paddingTop="16dp" android:paddingBottom="16dp">

        <LinearLayout android:id="@+id/profileArea"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="12dp"
            android:clickable="true" android:focusable="true"
            android:background="?attr/selectableItemBackground">

            <TextView android:id="@+id/tvAvatar"
                android:layout_width="44dp" android:layout_height="44dp"
                android:text="K" android:textColor="@color/accent"
                android:textSize="20sp" android:textStyle="bold" android:gravity="center"
                android:background="@drawable/bg_card" android:layout_marginEnd="12dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvStaffName"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Kasun Bandara" android:textColor="@color/white"
                    android:textSize="15sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvStaffRole"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Lead Technician · Colombo Branch" android:textColor="#B3FFFFFF"
                    android:textSize="12sp" android:layout_marginTop="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Metric chips -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_pill_white_20"
                android:paddingVertical="8dp" android:layout_marginEnd="8dp">
                <TextView android:id="@+id/tvActiveJobs"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="2" android:textColor="@color/white"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Active" android:textColor="#B3FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_pill_white_20"
                android:paddingVertical="8dp" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="3" android:textColor="#6EE7B7"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Done Today" android:textColor="#B3FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical" android:gravity="center"
                android:background="@drawable/bg_pill_white_20"
                android:paddingVertical="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="98%" android:textColor="#FDE68A"
                    android:textSize="20sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Quality" android:textColor="#B3FFFFFF" android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Priority filter -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/surface"
        android:paddingHorizontal="20dp" android:paddingVertical="10dp" android:elevation="2dp">
        <TextView android:id="@+id/filterAll"
            android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:text="All" android:textColor="@color/accent"
            android:textSize="13sp" android:textStyle="bold" android:gravity="center"
            android:background="@drawable/bg_pill_accent" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/filterUrgent"
            android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:text="Urgent" android:textColor="@color/text_dim"
            android:textSize="13sp" android:gravity="center"
            android:background="@drawable/bg_pill_surface" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/filterStandard"
            android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1"
            android:text="Standard" android:textColor="@color/text_dim"
            android:textSize="13sp" android:gravity="center"
            android:background="@drawable/bg_pill_surface" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvJobs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        android:scrollbars="none" />
</LinearLayout>
