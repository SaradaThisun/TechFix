<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header with step progress -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/surface"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Book a Repair"
            android:textColor="@color/text"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Step 1 of 4: Device &amp; Issue"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp" />

        <!-- Step bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <View android:id="@+id/step1" android:layout_width="0dp" android:layout_height="4dp"
                android:layout_weight="1" android:background="@color/accent"
                android:layout_marginEnd="4dp" />
            <View android:id="@+id/step2" android:layout_width="0dp" android:layout_height="4dp"
                android:layout_weight="1" android:background="@color/glass_border"
                android:layout_marginEnd="4dp" />
            <View android:id="@+id/step3" android:layout_width="0dp" android:layout_height="4dp"
                android:layout_weight="1" android:background="@color/glass_border"
                android:layout_marginEnd="4dp" />
            <View android:id="@+id/step4" android:layout_width="0dp" android:layout_height="4dp"
                android:layout_weight="1" android:background="@color/glass_border" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable step content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ── STEP 1: Device & Issue ── -->
            <LinearLayout
                android:id="@+id/step1Content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Device Type" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="16dp">

                    <LinearLayout android:id="@+id/btnPhone" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/bg_btn_primary" android:padding="14dp"
                        android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📱" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Mobile" android:textColor="@color/white"
                            android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnLaptop" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/bg_card" android:padding="14dp"
                        android:layout_marginEnd="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="💻" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Laptop" android:textColor="@color/text_dim"
                            android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnTablet" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:orientation="vertical" android:gravity="center"
                        android:background="@drawable/bg_card" android:padding="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📒" android:textSize="22sp" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Tablet" android:textColor="@color/text_dim"
                            android:textSize="11sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Brand" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <HorizontalScrollView android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:scrollbars="none"
                    android:layout_marginBottom="8dp">
                    <LinearLayout android:id="@+id/brandChips" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
                    android:layout_marginBottom="14dp">
                    <EditText android:id="@+id/etBrand" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="e.g. Apple, Samsung" android:textColorHint="@color/text_muted"
                        android:textColor="@color/text" android:textSize="14sp"
                        android:background="@null" android:paddingVertical="14dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Model *" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
                    android:layout_marginBottom="14dp">
                    <EditText android:id="@+id/etModel" android:layout_width="0dp"
                        android:layout_height="wrap_content" android:layout_weight="1"
                        android:hint="e.g. iPhone 15 Pro, Galaxy S24"
                        android:textColorHint="@color/text_muted" android:textColor="@color/text"
                        android:textSize="14sp" android:background="@null" android:paddingVertical="14dp" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Describe the Issue *" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
                    android:paddingTop="12dp" android:layout_marginBottom="14dp">
                    <EditText android:id="@+id/etIssue" android:layout_width="match_parent"
                        android:layout_height="90dp" android:hint="Describe what's wrong…"
                        android:textColorHint="@color/text_muted" android:textColor="@color/text"
                        android:textSize="14sp" android:background="@null"
                        android:gravity="top" android:inputType="textMultiLine" />
                </LinearLayout>

                <!-- Attach Photo button -->
                <LinearLayout android:id="@+id/btnAttachPhoto"
                    android:layout_width="match_parent" android:layout_height="54dp"
                    android:orientation="horizontal" android:gravity="center"
                    android:background="@drawable/bg_card" android:layout_marginBottom="4dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📷  Attach Device Photo (Optional)"
                        android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView android:id="@+id/tvPhotoAttached"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="✓ Photo attached" android:textColor="@color/success"
                    android:textSize="12sp" android:visibility="gone" android:layout_marginBottom="8dp" />
            </LinearLayout>

            <!-- ── STEP 2: Branch & Service ── -->
            <LinearLayout android:id="@+id/step2Content"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Select Branch" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <LinearLayout android:id="@+id/branchColomboCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_card_accent_border" android:padding="16dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📍 Colombo Branch" android:textColor="@color/accent"
                            android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Duplication Rd, Colombo 03" android:textColor="@color/text_dim"
                            android:textSize="12sp" />
                        <TextView android:id="@+id/tvColomboInventory"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Checking inventory..." android:textColor="@color/accent"
                            android:textSize="11sp" android:layout_marginTop="6dp"
                            android:background="@drawable/bg_pill_surface" android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp" />
                        <TextView android:id="@+id/tvColomboTechnicians"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textColor="@color/text_dim"
                            android:textSize="11sp" android:layout_marginTop="4dp" android:visibility="gone" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✓" android:textColor="@color/accent" android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/branchGalleCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_card" android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📍 Galle Branch" android:textColor="@color/text"
                            android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Main St, Galle Town" android:textColor="@color/text_dim"
                            android:textSize="12sp" />
                        <TextView android:id="@+id/tvGalleInventory"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Checking inventory..." android:textColor="@color/accent"
                            android:textSize="11sp" android:layout_marginTop="6dp"
                            android:background="@drawable/bg_pill_surface" android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp" />
                        <TextView android:id="@+id/tvGalleTechnicians"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="" android:textColor="@color/text_dim"
                            android:textSize="11sp" android:layout_marginTop="4dp" android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Auto-detect location button -->
                <LinearLayout android:id="@+id/btnDetectLocation"
                    android:layout_width="match_parent" android:layout_height="52dp"
                    android:orientation="horizontal" android:gravity="center"
                    android:background="@drawable/bg_btn_outline" android:layout_marginBottom="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📡  Auto-detect nearest branch"
                        android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold" />
                </LinearLayout>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Service Type" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <LinearLayout android:id="@+id/serviceDropoff"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_card_accent_border" android:padding="16dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🏪 In-Store Drop-off" android:textColor="@color/accent"
                            android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Walk in or drop your device at our lab"
                            android:textColor="@color/text_dim" android:textSize="12sp" />
                    </LinearLayout>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="✓" android:textColor="@color/accent" android:textSize="20sp" />
                </LinearLayout>

                <LinearLayout android:id="@+id/serviceCourier"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_card" android:padding="16dp"
                    android:layout_marginBottom="8dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="🚗 Courier Pickup" android:textColor="@color/text"
                            android:textSize="15sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="We pick up from your location"
                            android:textColor="@color/text_dim" android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/pickupAddressRow"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:visibility="gone">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pickup Address" android:textColor="@color/text_dim"
                        android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/bg_input" android:paddingHorizontal="14dp">
                        <EditText android:id="@+id/etPickupAddress" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:hint="Enter your full address"
                            android:textColorHint="@color/text_muted" android:textColor="@color/text"
                            android:textSize="14sp" android:background="@null" android:paddingVertical="14dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── STEP 3: Date & Time ── -->
            <LinearLayout android:id="@+id/step3Content"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Select Date" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <LinearLayout android:id="@+id/dateGrid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:layout_marginBottom="16dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Select Time Slot" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                <com.google.android.flexbox.FlexboxLayout android:id="@+id/timeSlotGrid"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" app:flexWrap="wrap"
                    android:layout_marginBottom="16dp" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:background="@drawable/bg_success" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🛡 " android:textSize="16sp" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="90-day warranty on all repairs. OEM certified parts."
                        android:textColor="@color/success" android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── STEP 4: Confirm ── -->
            <LinearLayout android:id="@+id/step4Content"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Review Your Booking" android:textColor="@color/text_dim"
                    android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="10dp" />

                <LinearLayout android:id="@+id/summaryCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@drawable/bg_card"
                    android:padding="16dp" android:layout_marginBottom="12dp">

                    <LinearLayout android:id="@+id/summaryDevice" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="10dp">
                        <TextView android:id="@+id/summaryDeviceIcon"
                            android:layout_width="30dp" android:layout_height="30dp"
                            android:text="📱" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_quick_blue" android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Device" android:textColor="@color/text_dim"
                                android:textSize="11sp" />
                            <TextView android:id="@+id/summaryDeviceValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Apple iPhone 15" android:textColor="@color/text"
                                android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/summaryIssue" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="10dp">
                        <TextView android:layout_width="30dp" android:layout_height="30dp"
                            android:text="🔧" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_quick_blue" android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Issue" android:textColor="@color/text_dim"
                                android:textSize="11sp" />
                            <TextView android:id="@+id/summaryIssueValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Cracked screen" android:textColor="@color/text"
                                android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/summaryBranch" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical" android:layout_marginBottom="10dp">
                        <TextView android:layout_width="30dp" android:layout_height="30dp"
                            android:text="📍" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_quick_blue" android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Branch" android:textColor="@color/text_dim"
                                android:textSize="11sp" />
                            <TextView android:id="@+id/summaryBranchValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Colombo Branch" android:textColor="@color/text"
                                android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:id="@+id/summaryDate" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView android:layout_width="30dp" android:layout_height="30dp"
                            android:text="📅" android:textSize="16sp" android:gravity="center"
                            android:background="@drawable/bg_quick_blue" android:layout_marginEnd="12dp" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Appointment" android:textColor="@color/text_dim"
                                android:textSize="11sp" />
                            <TextView android:id="@+id/summaryDateValue"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Today, 9:00 AM" android:textColor="@color/text"
                                android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="top"
                    android:background="@drawable/bg_card_accent_border" android:padding="12dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="ℹ " android:textSize="16sp" android:textColor="@color/accent" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Final pricing will be confirmed after diagnostics. No upfront payment required."
                        android:textColor="@color/text_dim" android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Nav bar (Back / Continue) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:elevation="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:text="← Back"
            android:textColor="@color/text_dim"
            android:textSize="14sp"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="20dp"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnContinue"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="Continue →"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary" />
    </LinearLayout>

</LinearLayout>
