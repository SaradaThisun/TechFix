<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_card_xl"
    android:layout_marginBottom="12dp"
    android:elevation="2dp"
    android:clipChildren="true">

    <!-- Left accent bar -->
    <View android:id="@+id/accentBar"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/accent" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:padding="14dp">

        <!-- Top row: icon + ref + status -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView android:id="@+id/ivDeviceIcon"
                android:layout_width="38dp" android:layout_height="38dp"
                android:text="📱" android:textSize="20sp" android:gravity="center"
                android:background="@drawable/bg_quick_blue" android:layout_marginEnd="10dp" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/tvRefId"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="#TF-7821" android:textColor="@color/accent"
                    android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/tvInvoice"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="INV-2026-7821" android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView android:id="@+id/tvStatus"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✓ Completed" android:textColor="@color/success"
                android:textSize="11sp" android:textStyle="bold"
                android:background="@drawable/bg_success"
                android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
        </LinearLayout>

        <TextView android:id="@+id/tvDeviceName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="MacBook Pro 14 M3" android:textColor="@color/text"
            android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="2dp" />

        <TextView android:id="@+id/tvServiceSummary"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Logic Board Micro-Soldering + Thermal Repaste"
            android:textColor="@color/text_dim" android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Meta row -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">
            <TextView android:id="@+id/tvDate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📅 2026-07-14" android:textColor="@color/text_dim"
                android:textSize="11sp" android:layout_marginEnd="14dp" />
            <TextView android:id="@+id/tvBranch"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📍 Colombo Branch" android:textColor="@color/text_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Warranty badge -->
        <TextView android:id="@+id/tvWarranty"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🛡 Warranty until 2026-10-14"
            android:textColor="@color/success" android:textSize="11sp" android:textStyle="bold"
            android:background="@drawable/bg_success"
            android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:layout_marginBottom="8dp"
            android:visibility="visible" />

        <!-- Footer -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <TextView android:id="@+id/tvCost"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:text="Rs. 38,500" android:textColor="@color/accent"
                android:textSize="18sp" android:textStyle="bold" />

            <TextView android:id="@+id/btnInvoice"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📄 Invoice"
                android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="10dp" android:paddingVertical="6dp"
                android:layout_marginEnd="8dp" />

            <TextView android:id="@+id/btnRebook"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="↺ Re-book"
                android:textColor="@color/text_dim" android:textSize="12sp"
                android:background="@drawable/bg_pill_surface"
                android:paddingHorizontal="10dp" android:paddingVertical="6dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
