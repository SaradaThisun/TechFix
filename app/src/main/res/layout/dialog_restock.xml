<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView android:id="@+id/tvRestockTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Restock: iPhone 15 Display"
        android:textColor="@color/text" android:textSize="16sp"
        android:textStyle="bold" android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Quantity to Add"
        android:textColor="@color/text_dim"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/etQuantity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter units to add"
        android:inputType="number"
        android:background="@drawable/bg_input"
        android:padding="14dp" />

</LinearLayout>
