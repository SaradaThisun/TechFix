<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_xl"
    android:padding="14dp"
    android:layout_marginBottom="12dp"
    android:elevation="2dp">

    <!-- Top row -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="12dp">

            <TextView android:id="@+id/ivDeviceIcon"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:text="📱" android:textSize="22sp" android:gravity="center"
                android:background="@drawable/bg_quick_blue" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivDevicePhoto"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />
        </FrameLayout>

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/tvTicketNum"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="#TF-8942" android:textColor="@color/accent"
                android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/tvBench"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Bench #04" android:textColor="@color/text_dim" android:textSize="11sp" />
        </LinearLayout>

        <TextView android:id="@+id/tvPriority"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Urgent" android:textColor="@color/danger"
            android:textSize="11sp" android:textStyle="bold"
            android:background="@drawable/bg_danger"
            android:paddingHorizontal="8dp" android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView android:id="@+id/tvDeviceModel"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="iPhone 15 Pro Max" android:textColor="@color/text"
        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="2dp" />

    <TextView android:id="@+id/tvCustomerNotes"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Please preserve all data."
        android:textColor="@color/text_dim" android:textSize="12sp" android:maxLines="1"
        android:layout_marginBottom="8dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:layout_marginBottom="10dp">

        <TextView android:id="@+id/tvStage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="In Repair" android:textColor="@color/purple"
            android:textSize="11sp" android:textStyle="bold"
            android:background="@drawable/bg_quick_purple"
            android:paddingHorizontal="10dp" android:paddingVertical="4dp"
            android:layout_marginEnd="10dp" />

        <TextView android:id="@+id/tvEta"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="⏱ Today 04:30 PM" android:textColor="@color/text_dim" android:textSize="11sp" />
    </LinearLayout>

    <Button android:id="@+id/btnViewPhoto"
        android:layout_width="match_parent" android:layout_height="44dp"
        android:text="📷  View Device Photo"
        android:textColor="@color/accent" android:textSize="13sp" android:textStyle="bold"
        android:background="@drawable/bg_btn_outline"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <Button android:id="@+id/btnOpenWorkbench"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:text="🔧  Open Workbench  →"
        android:textColor="@color/white" android:textSize="14sp" android:textStyle="bold"
        android:background="@drawable/bg_btn_primary" />
</LinearLayout>
