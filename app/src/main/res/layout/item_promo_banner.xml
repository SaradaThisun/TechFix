<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/promoCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/bg_promo_gradient">

    <TextView android:id="@+id/tvBadge"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Limited Offer" android:textColor="@color/white"
        android:textSize="11sp" android:textStyle="bold"
        android:background="@drawable/bg_pill_white_20"
        android:paddingHorizontal="8dp" android:paddingVertical="3dp"
        android:layout_marginBottom="2dp" />

    <TextView android:id="@+id/tvBranch"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Galle Branch" android:textColor="#CCFFFFFF"
        android:textSize="11sp" android:layout_marginBottom="2dp" />

    <TextView android:id="@+id/tvTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="24-Hour Express Repair in Galle!"
        android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold"
        android:lineSpacingExtra="2dp" android:layout_marginBottom="2dp" />

    <TextView android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Free diagnostic &amp; genuine OLED display replacements"
        android:textColor="#CCFFFFFF" android:textSize="11sp" android:layout_marginBottom="6dp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">

        <TextView android:id="@+id/tvCode"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="GALLE24" android:textColor="@color/white"
            android:textSize="11sp" android:textStyle="bold"
            android:background="@drawable/bg_pill_white_20"
            android:paddingHorizontal="8dp" android:paddingVertical="4dp"
            android:layout_marginEnd="8dp" />

        <TextView android:id="@+id/tvDiscount"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="15% OFF" android:textColor="@color/white"
            android:textSize="11sp" android:textStyle="bold"
            android:background="@drawable/bg_overlay_dark"
            android:paddingHorizontal="8dp" android:paddingVertical="4dp"
            android:layout_marginEnd="8dp" />

        <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

        <TextView android:id="@+id/btnClaim"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Claim →" android:textColor="@color/accent"
            android:textSize="12sp" android:textStyle="bold"
            android:background="@drawable/bg_card"
            android:paddingHorizontal="10dp" android:paddingVertical="5dp" />
    </LinearLayout>
</LinearLayout>
