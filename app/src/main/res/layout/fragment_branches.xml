<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- Header -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@color/surface" android:paddingHorizontal="20dp"
        android:paddingTop="16dp" android:paddingBottom="12dp" android:elevation="2dp">

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Our Branches" android:textColor="@color/text"
                android:textSize="22sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="2 Active Labs in Sri Lanka" android:textColor="@color/text_dim"
                android:textSize="13sp" android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="● Both Open" android:textColor="@color/success"
            android:textSize="12sp" android:textStyle="bold"
            android:background="@drawable/bg_success" android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:scrollbars="none">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingBottom="80dp">

            <!-- Map representation -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="180dp"
                android:layout_marginHorizontal="20dp" android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp" app:cardElevation="3dp"
                app:cardBackgroundColor="#EFF6FF">

                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">

                    <!-- Map Interface Trigger -->
                    <LinearLayout
                        android:id="@+id/mapInterface"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🗺"
                            android:textSize="48sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Open in Google Maps"
                            android:textColor="@color/accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="10dp"
                        android:text="Sri Lanka" android:textColor="@color/text_muted"
                        android:textSize="11sp" android:textStyle="bold" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="12dp"
                        android:text="119 km · E01 Highway"
                        android:textColor="@color/text_dim" android:textSize="10sp"
                        android:background="@drawable/bg_card"
                        android:paddingHorizontal="8dp" android:paddingVertical="3dp" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- Branch tabs -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingHorizontal="20dp"
                android:layout_marginBottom="16dp">

                <TextView android:id="@+id/tabColombo"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="Colombo HQ" android:textColor="@color/white"
                    android:textSize="13sp" android:textStyle="bold" android:gravity="center"
                    android:background="@drawable/bg_btn_primary" android:layout_marginEnd="8dp" />

                <TextView android:id="@+id/tabGalle"
                    android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1"
                    android:text="Galle Hub" android:textColor="@color/text_dim"
                    android:textSize="13sp" android:gravity="center"
                    android:background="@drawable/bg_pill_surface" />
            </LinearLayout>

            <!-- Branch detail card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                app:cardCornerRadius="20dp" app:cardElevation="5dp"
                app:strokeColor="@color/glass_border" app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/surface">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <TextView android:id="@+id/tvBranchName"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="Colombo Branch"
                            android:textColor="@color/text" android:textSize="20sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="● Open Now" android:textColor="@color/success"
                            android:textSize="12sp" android:textStyle="bold"
                            android:background="@drawable/bg_success"
                            android:paddingHorizontal="8dp" android:paddingVertical="3dp" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvRating"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⭐ 4.9  (384 reviews)"
                        android:textColor="@color/text_dim" android:textSize="13sp"
                        android:layout_marginBottom="14dp" />

                    <!-- Metrics -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="14dp">

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:gravity="center" android:background="@color/bg_alt"
                            android:padding="12dp" android:layout_marginEnd="8dp">
                            <TextView android:id="@+id/tvTechCount"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="8" android:textColor="@color/accent"
                                android:textSize="18sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Technicians" android:textColor="@color/text_dim"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical"
                            android:gravity="center" android:background="@color/bg_alt"
                            android:padding="12dp">
                            <TextView android:id="@+id/tvStockLevel"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="High (98%)" android:textColor="@color/success"
                                android:textSize="14sp" android:textStyle="bold" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Parts Stock" android:textColor="@color/text_dim"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Address -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="top"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📍 " android:textSize="16sp" android:textColor="@color/accent" />
                        <TextView android:id="@+id/tvAddress"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="No. 428, R.A. De Mel Mawatha, Colombo 03"
                            android:textColor="@color/text_dim" android:textSize="13sp" />
                    </LinearLayout>

                    <!-- Hours -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="top"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="⏰ " android:textSize="16sp" android:textColor="@color/accent" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical">
                            <TextView android:id="@+id/tvHours"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Mon – Sat: 8:30 AM – 7:30 PM"
                                android:textColor="@color/text_dim" android:textSize="13sp" />
                            <TextView android:id="@+id/tvWeekendHours"
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Sunday: 9:00 AM – 3:00 PM"
                                android:textColor="@color/text_dim" android:textSize="13sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Phone buttons -->
                    <LinearLayout android:id="@+id/btnPhone1"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_pill_accent" android:padding="10dp"
                        android:layout_marginBottom="6dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📞 " android:textSize="14sp" />
                        <TextView android:id="@+id/tvPhone1"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+94 11 259 8870" android:textColor="@color/accent"
                            android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/btnPhone2"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical"
                        android:background="@drawable/bg_pill_accent" android:padding="10dp"
                        android:layout_marginBottom="14dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="📱 " android:textSize="14sp" />
                        <TextView android:id="@+id/tvPhone2"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="+94 77 123 4567" android:textColor="@color/accent"
                            android:textSize="13sp" android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Popular services -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Specialised Services" android:textColor="@color/text_dim"
                        android:textSize="12sp" android:textStyle="bold" android:layout_marginBottom="8dp" />

                    <com.google.android.flexbox.FlexboxLayout android:id="@+id/popularServicesContainer"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" app:flexWrap="wrap"
                        android:layout_marginBottom="14dp" />

                    <!-- Action buttons -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button android:id="@+id/btnBookBranch"
                            android:layout_width="match_parent" android:layout_height="52dp"
                            android:text="@string/book_this_branch"
                            android:textColor="@color/white" android:textSize="13sp" android:textStyle="bold"
                            android:background="@drawable/bg_btn_primary" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
