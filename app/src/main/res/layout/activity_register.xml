<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="60dp"
        android:paddingBottom="40dp">

        <!-- Back button -->
        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Back"
            android:textColor="@color/text_dim"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="TF"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TechFix"
                    android:textColor="@color/text"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginStart="10dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register_subtitle"
                android:textColor="@color/text_dim"
                android:textSize="13sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/btnDemoFill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Auto Fill Demo"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_accent"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/btnStaffDemo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠 Staff Demo Fill"
                android:textColor="@color/purple"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_surface"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Error box -->
        <LinearLayout
            android:id="@+id/errorBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_danger"
            android:padding="12dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠ "
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/danger"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Full Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Full Name *"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="👤" android:textSize="16sp" android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etFullName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Your full name"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:inputType="textPersonName|textCapWords"
                android:background="@null"
                android:paddingVertical="14dp" />
        </LinearLayout>

        <!-- Phone -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Phone Number *"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="📞" android:textSize="16sp" android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="+94 7X XXX XXXX"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:inputType="phone"
                android:background="@null"
                android:paddingVertical="14dp" />
        </LinearLayout>

        <!-- Email -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address *"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="14dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✉" android:textSize="16sp" android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="email@example.com"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:inputType="textEmailAddress"
                android:background="@null"
                android:paddingVertical="14dp" />
        </LinearLayout>

        <!-- Preferred Branch -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferred Branch *"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:id="@+id/cardColombo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_btn_primary"
                android:padding="14dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:id="@+id/tvColomboName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Colombo"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvColomboStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open • 8 Techs"
                    android:textColor="#CCFFFFff"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/cardGalle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_card"
                android:padding="14dp">

                <TextView
                    android:id="@+id/tvGalleName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Galle"
                    android:textColor="@color/text_dim"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGalleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Open • 5 Techs"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Password *"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="6dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔒" android:textSize="16sp" android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Create a password"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:background="@null"
                android:paddingVertical="14dp" />

            <TextView
                android:id="@+id/btnTogglePass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👁"
                android:textSize="18sp"
                android:paddingStart="8dp" />
        </LinearLayout>

        <!-- Strength bar -->
        <LinearLayout
            android:id="@+id/strengthRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <View android:id="@+id/seg1" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="@color/glass_border"
                    android:layout_marginEnd="3dp" />
                <View android:id="@+id/seg2" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="@color/glass_border"
                    android:layout_marginEnd="3dp" />
                <View android:id="@+id/seg3" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="@color/glass_border"
                    android:layout_marginEnd="3dp" />
                <View android:id="@+id/seg4" android:layout_width="0dp" android:layout_height="4dp"
                    android:layout_weight="1" android:background="@color/glass_border" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStrength"
                android:layout_width="55dp"
                android:layout_height="wrap_content"
                android:text="Weak"
                android:textColor="@color/danger"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="end"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Confirm Password -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Password *"
            android:textColor="@color/text_dim"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔒" android:textSize="16sp" android:layout_marginEnd="10dp" />

            <EditText
                android:id="@+id/etConfirmPassword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Repeat your password"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:background="@null"
                android:paddingVertical="14dp" />
        </LinearLayout>

        <!-- Register button -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/register_now"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_primary"
            android:layout_marginBottom="24dp" />

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/already_have_account"
                android:textColor="@color/text_dim"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSignIn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Sign In"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
